{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deployer": "vite --config vite.deployer.config.ts",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run test && npm run build",
    "check:okf": "node .claude/skills/pwa-miniapp-sdd/scripts/check-okf.mjs knowledge",
    "pretest": "node scripts/make-fixtures.mjs",
    "pretest:e2e": "node scripts/make-fixtures.mjs",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "dexie": "^4.4.7",
    "foliate-js": "1.0.1",
    "preact": "^11.1.1",
    "qrcode-generator": "^2.0.4",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@fission-ai/openspec": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@types/spark-md5": "^3.0.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.8",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.166.0"
  }
}
