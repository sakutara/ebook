# Cloudflare Worker that serves the R2 bucket, e.g. https://tu-truyen.<account>.workers.dev
VITE_R2_BASE_URL=
# Deployer only (npm run deployer): admin code, pre-filled so you do not type it. It has no VITE_
# prefix, so the reader app never receives it.
R2_SECRET=
# Donate: receiving bank. Accepts a code, name or BIN: VCB / Vietcombank / 970436
VITE_DONATE_BANK=
# Donate: bank account number (spaces and dots are ignored)
VITE_DONATE_ACCOUNT_NO=
# Donate: account holder name, as printed on the bank account
VITE_DONATE_ACCOUNT_NAME=
# Donate: transfer note, ASCII only, max 25 chars (default: donate token dich truyen)
VITE_DONATE_NOTE=
# Story request: the 1FAIpQL... id from the form's /d/e/<id>/viewform URL
VITE_REQUEST_FORM_ID=
# Story request: entry id of the "title" question (Form ⋮ → "Get pre-filled link", fill, copy link, read entry.<n>)
VITE_REQUEST_ENTRY_TITLE=
# Story request: entry id of the "author" question (same method as above)
VITE_REQUEST_ENTRY_AUTHOR=
# Story request: entry id of the optional "key" question (same method as above)
VITE_REQUEST_ENTRY_KEY=
# Story request: entry id of the optional "original title" question (leave empty to skip)
VITE_REQUEST_ENTRY_ORIGINAL_TITLE=
# Story request: entry id of the optional "language" question (leave empty to skip)
VITE_REQUEST_ENTRY_LANGUAGE=
